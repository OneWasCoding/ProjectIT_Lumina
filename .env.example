# Supabase Configuration
# Get these from: https://supabase.com -> Your Project -> Settings -> API
VITE_SUPABASE_URL=your-project-url-here
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key-here

# Groq AI Configuration (for AI-powered quiz generation)
# Get your API key from: https://console.groq.com/keys
# Set GROQ_API_KEY on Vercel (for /api/groq/chat) and VITE_GROQ_API_KEY for local dev / static hosts
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1/chat/completions
VITE_GROQ_API_KEY=your_groq_api_key
VITE_GROQ_MODEL=llama-3.3-70b-versatile
VITE_GROQ_BASE_URL=https://api.groq.com/openai/v1/chat/completions
